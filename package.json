{
  "name": "lpl-pms",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "author": "Bhanu Mendis",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "contrast": "node scripts/contrast.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts --max-warnings 0",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run contrast",
    "build": "npm run verify && vite build && node scripts/finalize.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^3.2.7"
  }
}
