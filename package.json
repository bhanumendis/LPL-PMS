{
  "name": "lpl-pms",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "author": "Bhanu Mendis - Group IT",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.node.json",
    "contrast": "node scripts/contrast.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts --max-warnings 0",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run contrast",
    "build": "npm run verify && vite build && node scripts/finalize.mjs",
    "preview": "vite preview",
    "parity:update": "vite-node scripts/update-parity.ts",
    "test:e2e": "scripts/e2e-api.sh",
    "test:ui": "scripts/e2e-ui.sh"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vite-node": "^5.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.56.1"
    }
  }
}
