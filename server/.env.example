# lpl-api — runtime configuration. Copy to .env for local runs; never commit real values.

# Address the HTTP listener binds to.
LISTEN_ADDR=:8080

# Postgres. The role must be able to SET ROLE to anon, authenticated and service_role
# (Supabase's postgres and authenticator roles can). Use the session pooler (5432) or the
# transaction pooler (6543); on 6543 prepared statements are disabled automatically.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
DB_MAX_CONNS=8
# DB_SIMPLE_PROTOCOL=true
# Role used for system work that must bypass the guards (auth.uid() is null). "none" = no switch.
DB_SYSTEM_ROLE=service_role

# GoTrue base URL without a trailing slash:
#   Supabase project:  https://<ref>.supabase.co/auth/v1
#   bare GoTrue:       http://localhost:9999
GOTRUE_URL=https://your-project-ref.supabase.co/auth/v1

# The public key the browser presents (Project Settings → API → anon / publishable key).
ANON_KEY=
# Service role key, used only server-side for GoTrue's admin API. Never expose it.
SERVICE_ROLE_KEY=

# User-token verification: one of the two.
#   Legacy projects sign HS256 with the project's JWT secret (Project Settings → API → JWT Secret).
#   Projects on asymmetric signing keys publish a JWKS.
JWT_SECRET=
# JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
JWT_LEEWAY=0s

REQUEST_TIMEOUT=30s
MAX_BODY_BYTES=10485760
CORS_ALLOW_ORIGIN=*
