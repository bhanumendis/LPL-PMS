# lpl-api — runtime configuration. Copy to .env for local runs; never commit real values.

# Address the HTTP listener binds to.
LISTEN_ADDR=:8080

# Postgres. The role must be able to SET ROLE to anon, authenticated and service_role
# (Supabase's postgres and authenticator roles can). Use the session pooler (5432) or the
# transaction pooler (6543); on 6543 prepared statements are disabled automatically.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
DB_MAX_CONNS=8
# DB_SIMPLE_PROTOCOL=true
# Role used for system work that must bypass the guards (auth.uid() is null). "none" = no switch.
DB_SYSTEM_ROLE=service_role

# GoTrue base URL without a trailing slash:
#   Supabase project:  https://<ref>.supabase.co/auth/v1
#   bare GoTrue:       http://localhost:9999
GOTRUE_URL=https://your-project-ref.supabase.co/auth/v1

# The public key the browser presents (Project Settings → API → anon / publishable key).
ANON_KEY=
# Service role key, used only server-side for GoTrue's admin API. Never expose it.
SERVICE_ROLE_KEY=

# User-token verification: one of the two.
#   Legacy projects sign HS256 with the project's JWT secret (Project Settings → API → JWT Secret).
#   Projects on asymmetric signing keys publish a JWKS.
JWT_SECRET=
# JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
JWT_LEEWAY=0s

REQUEST_TIMEOUT=30s
MAX_BODY_BYTES=10485760

# production (default) or development. Production refuses a wildcard or http CORS origin and
# turns on HSTS.
APP_ENV=production
# The origin(s) the web application is served from, comma-separated. Required in production.
CORS_ALLOW_ORIGINS=https://pms.lyceum.lk
# Reverse proxies in front of lpl-api that append to X-Forwarded-For (a load balancer = 1).
# 0 trusts only the TCP peer address; never set it higher than the real number of proxies.
TRUSTED_PROXY_HOPS=0
# Per-client-IP budgets per minute (0 disables): password sign-in and sign-up, account
# administration, and the data API.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_ADMIN_PER_MINUTE=30
RATE_LIMIT_API_PER_MINUTE=600
# HSTS=true

# Background work (all replicas may run it; the jobs coordinate through the database).
# WORKERS=false serves requests only. Each interval: 0 switches that job off.
WORKERS=true
PUSH_INTERVAL=10s
SLA_REMINDER_INTERVAL=15m
DASHBOARD_REFRESH_INTERVAL=1m
PRUNE_INTERVAL=6h
NOTIFICATION_RETENTION_DAYS=90

# Web Push. All three or none (none: push delivery is off; in-app notifications still work).
# Generate once with `npx web-push generate-vapid-keys`; paste the public key in the
# application under Settings → Notifications as well. The private key is a secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# e.g. VAPID_SUBJECT=mailto:it@lyceum.lk (a contact for push-service operators)
# Push services the dispatcher may contact (host and its subdomains), comma-separated.
# Default: fcm.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com
# PUSH_ENDPOINT_HOSTS=
