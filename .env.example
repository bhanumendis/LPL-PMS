# Build-time API connection. Required for `npm run build` (production): the build refuses to
# run without it, and refuses a service-role or secret key.
#   VITE_API_URL       the lpl-api origin the application talks to (https; localhost allowed for E2E)
#   VITE_API_ANON_KEY  the PUBLIC anon/publishable key. Never the service_role key.
# `npm run dev` does not need these: development builds can store records in the browser or be
# pointed at a test stack from Settings.
VITE_API_URL=https://api.pms.example.lk
VITE_API_ANON_KEY=your-public-anon-key
